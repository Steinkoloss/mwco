<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net461</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MWCO.Shared/MWCO.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Try to find Unity Engine DLLs - support multiple installation paths -->
    <!-- Windows Steam paths -->
    <Reference Include="UnityEngine" Condition="Exists('C:\Program Files (x86)\Steam\steamapps\common\My Winter Car\mywintercar_Data\Managed\UnityEngine.dll')">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\My Winter Car\mywintercar_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp" Condition="Exists('C:\Program Files (x86)\Steam\steamapps\common\My Winter Car\mywintercar_Data\Managed\Assembly-CSharp.dll')">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\My Winter Car\mywintercar_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PlayMaker" Condition="Exists('C:\Program Files (x86)\Steam\steamapps\common\My Winter Car\mywintercar_Data\Managed\PlayMaker.dll')">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\My Winter Car\mywintercar_Data\Managed\PlayMaker.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- BepInEx core - copy from game install into ../lib/BepInEx.dll if not present -->
    <Reference Include="BepInEx" Condition="Exists('../lib/BepInEx.dll')">
      <HintPath>../lib/BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Harmony for runtime patching -->
    <PackageReference Include="Lib.Harmony" Version="2.2.2" />
  </ItemGroup>

</Project>
